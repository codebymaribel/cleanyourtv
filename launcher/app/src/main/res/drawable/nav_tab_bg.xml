<?xml version="1.0" encoding="utf-8"?>
<!-- Nav bar tab (nav_tabs): no pill and no fill, only a line under the selected tab's text. Bright while the tab has
     focus, dimmer while focus is elsewhere (in the dock or the pills). The insets match NavTab's side padding, so
     the line is as wide as the text. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:gravity="bottom|fill_horizontal" android:height="2dp"
                android:left="14dp" android:right="14dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="bottom|fill_horizontal" android:height="2dp"
                android:left="14dp" android:right="14dp">
                <shape android:shape="rectangle">
                    <solid android:color="#80FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
