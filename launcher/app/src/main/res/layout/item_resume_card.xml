<?xml version="1.0" encoding="utf-8"?>
<!-- One title in Home's Continue Watching row: its backdrop at 16:9, its name and episode, and how far in it is. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/resume_card_width"
    android:layout_height="@dimen/resume_card_height"
    android:layout_marginStart="@dimen/title_card_margin"
    android:layout_marginEnd="@dimen/title_card_margin"
    android:background="@drawable/title_card_bg"
    android:foreground="@drawable/resume_card_ring"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/resumeImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@drawable/resume_card_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/resumeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="@string/font_medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/resumeEpisode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@string/font_regular"
            android:singleLine="true" />
    </LinearLayout>

    <!-- How far in: the fill scales from the left over the track (ResumeRow sets scaleX). -->
    <FrameLayout
        android:id="@+id/resumeProgressTrack"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:background="#40FFFFFF">

        <View
            android:id="@+id/resumeProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:transformPivotX="0dp"
            android:background="#FFFFFFFF" />
    </FrameLayout>
</FrameLayout>
