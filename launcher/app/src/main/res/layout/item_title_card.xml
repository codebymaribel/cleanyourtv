<?xml version="1.0" encoding="utf-8"?>
<!-- One title in a nav tab's row: its poster, or its name on a coloured placeholder until there is one. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/title_card_width"
    android:layout_height="@dimen/title_card_height"
    android:layout_margin="@dimen/title_card_margin"
    android:background="@drawable/title_card_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/titlePoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/titlePlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@string/font_medium"
        android:maxLines="4"
        android:ellipsize="end" />
</FrameLayout>
